# Server
ENV=development
HOST=0.0.0.0
PORT=8000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=interviewlab

# Auth
JWT_SECRET=change-this-local-secret-before-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email over HTTPS (recommended for cloud servers)
RESEND_API_KEY=
RESEND_FROM=InterviewLab <notifications@send.example.com>

# Optional SMTP fallback when RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=InterviewLab <no-reply@example.com>

# AI analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite

# Recordings
RECORDINGS_DIR=./data/recordings
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_BYTES=2000000000
RECORDING_MAX_CHUNK_BYTES=25000000

# Misc
INVITE_LINK_BASE_URL=http://localhost:5173/test
